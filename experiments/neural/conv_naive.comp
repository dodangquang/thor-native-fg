#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D inputImage;
layout(binding=1,rgba16f) uniform writeonly image2D outputImage;
layout(binding=2,std430) readonly buffer Weights {vec4 values[];} weights;
layout(push_constant) uniform Params {int width,height,inputs,outputs,groups,weightOffset,biasOffset,first;} p;
vec4 readInput(ivec2 at,int group){
 if(any(lessThan(at,ivec2(0)))||any(greaterThanEqual(at,ivec2(p.width,p.height))))return vec4(0);
 if(p.first!=0)return vec4(texelFetch(inputImage,at,0).rgb,0);
 return texelFetch(inputImage,ivec2(at.x*8+group,at.y),0);
}
void main(){
 ivec2 at=ivec2(gl_GlobalInvocationID.xy);int outputGroup=int(gl_WorkGroupID.z);
 if(any(greaterThanEqual(at,ivec2(p.width,p.height))))return;
 vec4 sum=weights.values[p.biasOffset+outputGroup];
 int block=p.weightOffset+outputGroup*9*p.groups*4;
 for(int y=0;y<3;y++)for(int x=0;x<3;x++)for(int group=0;group<p.groups;group++){
  vec4 sampleValue=readInput(at+ivec2(x-1,y-1),group);
  int base=block+((y*3+x)*p.groups+group)*4;
  sum=fma(vec4(sampleValue.x),weights.values[base],sum);
  sum=fma(vec4(sampleValue.y),weights.values[base+1],sum);
  sum=fma(vec4(sampleValue.z),weights.values[base+2],sum);
  sum=fma(vec4(sampleValue.w),weights.values[base+3],sum);
 }
 imageStore(outputImage,ivec2(at.x*8+outputGroup,at.y),clamp(sum,0,1));
}
