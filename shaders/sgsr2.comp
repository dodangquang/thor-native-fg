// Spatial-only adaptation of SGSR2's FastLanczos kernel; no temporal reconstruction.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D InputColor;
layout(binding=1,rgba8) uniform writeonly image2D OutputImage;
layout(push_constant) uniform Params {ivec2 outputSize;} p;
float FastLanczos(float base){
    float y=base-1.0,y2=y*y;
    return (0.75*y+y2)*y2;
}
void main(){
    ivec2 at=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(at,p.outputSize)))return;
    ivec2 size=textureSize(InputColor,0);
    vec2 uv=(vec2(at)+0.5)/vec2(p.outputSize);
    vec2 pos=uv*vec2(size)-0.5;
    // 4x4 support (two-lobe Lanczos) instead of 3x3: the previous kernel's
    // taps never reached the point where FastLanczos actually decays to
    // zero, so it behaved like a soft box blur and lost detail versus the
    // emulators' own upscalers. floor(pos) plus a -1..2 tap range centers
    // the full two-lobe footprint on the sample instead of the nearest texel.
    ivec2 base=ivec2(floor(pos));
    vec3 low=vec3(1),high=vec3(0),sum=vec3(0);
    float weights=0;
    for(int y=-1;y<=2;y++)for(int x=-1;x<=2;x++){
        ivec2 tap=base+ivec2(x,y);
        vec3 c=texelFetch(InputColor,clamp(tap,ivec2(0),size-1),0).rgb;
        vec2 d=vec2(tap)-pos;
        float w=FastLanczos(clamp(dot(d,d)*0.25,0.0,1.0));
        sum+=c*w;weights+=w;
        if(x>=0&&x<=1&&y>=0&&y<=1){low=min(low,c);high=max(high,c);}
    }
    vec4 source=textureLod(InputColor,uv,0);
    vec3 rgb=abs(weights)>1e-6?clamp(sum/weights,low,high):source.rgb;
    imageStore(OutputImage,at,vec4(rgb,source.a));
}
