#version 450
#extension GL_GOOGLE_include_directive : require
#include "neural_bounds.glsl"
// Anime4K CNN S residual/PixelShuffle adapter. Preserve source alpha separately.
// ENHANCED for DLSS-like quality: edge-aware reconstruction, better anti-ringing
