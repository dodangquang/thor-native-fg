#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D prevFrame;
layout(binding=1) uniform sampler2D currFrame;
layout(binding=2,rgba32f) uniform writeonly image2D flowImage;
#define THOR_QUALITY_BINDING 3
#include "quality.glsl"
layout(push_constant) uniform Params { ivec2 inputSize; ivec2 gridSize; float phase; int history; } p;
float delta(vec3 a, vec3 b) { return dot(abs(a-b),vec3(0.299,0.587,0.114)); }
// One workgroup owns a block. Share its16reference samples; independent lanes
// evaluate the same81candidates as the serial reference. Reduction includes the
// original candidate index so ties preserve the serial y/x traversal exactly.
shared vec4 previousPatch[16],currentPatch[16];
shared float forwardCost[64],backwardCost[64];
shared uint forwardIndex[64],backwardIndex[64];
void main(){
  ivec2 at=ivec2(gl_WorkGroupID.xy);if(any(greaterThanEqual(at,p.gridSize)))return;
  uint lane=gl_LocalInvocationIndex;
  vec2 fullGrid=vec2(p.gridSize*8),center=(vec2(at*8)+4.0)/fullGrid;
  if(lane<16u){
    ivec2 sampleAt=ivec2(int(lane)%4,int(lane)/4)*2-3;
    vec2 uv=center+vec2(sampleAt)/fullGrid;
    previousPatch[lane]=textureLod(prevFrame,uv,0);
    currentPatch[lane]=textureLod(currFrame,uv,0);
  }
  barrier();
  float fBest=100.0,bBest=100.0;uint fIndex=81u,bIndex=81u;
  for(uint candidate=lane;candidate<81u;candidate+=64u){
    int x=int(candidate)%9-4,y=int(candidate)/9-4;vec2 offset=vec2(x,y)/fullGrid;
    float fCost=0,bCost=0;int sampleIndex=0;
    for(int j=-3;j<=3;j+=2)for(int i=-3;i<=3;i+=2){
      vec2 uv=center+vec2(i,j)/fullGrid;
      fCost+=delta(previousPatch[sampleIndex].rgb,textureLod(currFrame,uv+offset,0).rgb);
      bCost+=delta(currentPatch[sampleIndex].rgb,textureLod(prevFrame,uv+offset,0).rgb);
      sampleIndex++;
    }
    fCost=fCost/16.0+0.00003*float(x*x+y*y);bCost=bCost/16.0+0.00003*float(x*x+y*y);
    if(fCost<fBest){fBest=fCost;fIndex=candidate;}
    if(bCost<bBest){bBest=bCost;bIndex=candidate;}
  }
  forwardCost[lane]=fBest;backwardCost[lane]=bBest;forwardIndex[lane]=fIndex;backwardIndex[lane]=bIndex;
  barrier();
  for(uint stride=32u;stride>0u;stride/=2u){
    if(lane<stride){uint other=lane+stride;
      if(forwardCost[other]<forwardCost[lane]||(forwardCost[other]==forwardCost[lane]&&forwardIndex[other]<forwardIndex[lane])){forwardCost[lane]=forwardCost[other];forwardIndex[lane]=forwardIndex[other];}
      if(backwardCost[other]<backwardCost[lane]||(backwardCost[other]==backwardCost[lane]&&backwardIndex[other]<backwardIndex[lane])){backwardCost[lane]=backwardCost[other];backwardIndex[lane]=backwardIndex[other];}
    }
    barrier();
  }
  if(lane!=0u)return;
  vec3 f=vec3(vec2(int(forwardIndex[0])%9-4,int(forwardIndex[0])/9-4)/fullGrid,forwardCost[0]);
  vec3 b=vec3(vec2(int(backwardIndex[0])%9-4,int(backwardIndex[0])/9-4)/fullGrid,backwardCost[0]);
  imageStore(flowImage,at,vec4(f.xy,b.xy));
  atomicAdd(stats.valid,(f.z<0.075 && b.z<0.075)?1u:0u);
  vec2 scale=vec2(p.gridSize*8);
  bool edge=any(greaterThanEqual(abs(f.xy*scale),vec2(3.5)))||any(greaterThanEqual(abs(b.xy*scale),vec2(3.5)));
  atomicAdd(stats.boundary,edge?1u:0u);
}
