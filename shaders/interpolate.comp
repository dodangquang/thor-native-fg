#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D prevFrame;
layout(binding=1) uniform sampler2D currFrame;
layout(binding=2) uniform sampler2D flowImage;
layout(binding=3,rgba8) uniform writeonly image2D result;
#define THOR_QUALITY_BINDING 4
#include "quality.glsl"
layout(binding=5) uniform sampler2D costImage;
layout(push_constant) uniform Params { ivec2 inputSize; ivec2 gridSize; float phase; int history; } p;
float channelMax(vec3 v){return max(max(v.r,v.g),v.b);}
bool stationaryPatch(ivec2 at){
  // Exact unchanged RGB wins over a neighbouring block's motion. This also
  // protects one-pixel HUD strokes with moving scenery immediately beside
  // them; requiring static neighbours would fail at precisely those edges.
  // This is a conservative colour test, not semantic HUD detection.
  // Alpha is checked too: an alpha-only fade (RGB unchanged) must still take
  // the motion-compensated path below so its alpha gets interpolated instead
  // of flashing fully opaque.
  vec4 previous=texelFetch(prevFrame,at,0),current=texelFetch(currFrame,at,0);
  // Screen-space static content (HUD, stamina wheel): the flow comes from the
 // moving scene, so warping these pixels drags a dark ghost arc next to them.
 // A few LSB of tolerance keeps antialiasing/hue shifts from defeating it.
 return max(channelMax(abs(previous.rgb-current.rgb)),abs(previous.a-current.a))<4.0/255.0;
}
// Joint bilateral flow upsampling. A neighbouring block whose colour differs
// from this pixel belongs to another object, so its motion must not bleed across
// the edge: that bleed is what makes the generated frame tear along a fast pan.
vec4 flowNear(vec2 uv,vec3 color){
  vec2 g=uv*vec2(p.gridSize)-0.5;
  ivec2 base=ivec2(floor(g));
  vec2 f=g-vec2(base);
  vec4 acc=vec4(0.0);float wsum=0.0;
  for(int j=0;j<2;j++)for(int i=0;i<2;i++){
    ivec2 cell=clamp(base+ivec2(i,j),ivec2(0),p.gridSize-1);
    vec2 cuv=(vec2(cell)+0.5)/vec2(p.gridSize);
    vec3 d=textureLod(currFrame,cuv,0).rgb-color;
    float w=(i==0?1.0-f.x:f.x)*(j==0?1.0-f.y:f.y);
    w*=exp(-dot(d,d)*80.0);
    acc+=textureLod(flowImage,cuv,0)*w;wsum+=w;
  }
  return wsum>1e-5?acc/wsum:textureLod(flowImage,uv,0);
}void main(){
  ivec2 at=ivec2(gl_GlobalInvocationID.xy); if(any(greaterThanEqual(at,p.inputSize)))return;
  vec2 uv=(vec2(at)+0.5)/vec2(p.inputSize); vec4 current=textureLod(currFrame,uv,0);vec4 color=current;
  // The quality gate used to duplicate the current frame whenever it rejected,
  // which shows up as 30 FPS content repeated on a 60 Hz display (judder on fast
  // pans over detailed scenes, where the flow search saturates). Keep a reduced
  // interpolation for the non-cut rejects so motion survives; a real cut still
  // gets the duplicate, because blending across it would ghost two scenes.
  // Gate fallback: a genuine cut (few blocks matched even loosely) keeps the
  // duplicate; a misread "cut" on a well-matched pan keeps 45% of the motion so
  // the occasional 30 FPS blip disappears instead of stalling the whole frame.
  float gate=1.0;
  if(p.history!=0 && stats.allow==0u){
    float coarseBlocks=max(float(p.gridSize.x)*float(p.gridSize.y)/4.0,1.0);
    float validFraction=float(stats.valid)/coarseBlocks;
    bool trueCut=(stats.reasons&1u)!=0u&&validFraction<0.55;
    gate=trueCut?0.0:0.45;
  }
  if(p.history!=0 && gate>0.0){
    vec4 flow=flowNear(uv,current.rgb);
    // The two endpoints must be sampled at the requested temporal position, not
    // always at the half-way point: at phase 1/3 the previous frame is sampled
    // one third of the motion back and the current frame two thirds forward.
    // Hard-coding 0.5 here made every phase produce the same midpoint image.
    float tWarp=clamp(p.phase,0.0f,1.0f);
    vec2 aUV=uv-tWarp*flow.xy,bUV=uv-(1.0-tWarp)*flow.zw;
    // Flow is attached to each endpoint, not to the output time. Refine the
    // inverse mapping before sampling instead of assigning a neighbouring
    // object's block motion directly to this output pixel.
    for(int i=0;i<2;i++){
      aUV=uv-tWarp*textureLod(flowImage,aUV,0).xy;
      bUV=uv-(1.0-tWarp)*textureLod(flowImage,bUV,0).zw;
    }
    vec4 a=textureLod(prevFrame,aUV,0),b=textureLod(currFrame,bUV,0);
    vec2 forward=textureLod(flowImage,aUV,0).xy;
    vec2 reverse=textureLod(flowImage,bUV,0).zw;
    float consistency=length((forward+reverse)*vec2(p.gridSize*8));
    bool bounds=all(greaterThanEqual(aUV,vec2(0)))&&all(lessThanEqual(aUV,vec2(1)))&&all(greaterThanEqual(bUV,vec2(0)))&&all(lessThanEqual(bUV,vec2(1)));
    // Soft quality gate instead of a hard cutoff: fade the generated colour
    // in/out with flow confidence so pixels near the consistency boundary
    // blend gradually over frames instead of popping on/off. The previous
    // binary reject flickered wherever Jitter pushed a pixel across 1.5.
    float mismatch=channelMax(abs(a.rgb-b.rgb));
    float conf=1.0-smoothstep(0.6,1.8,consistency);
    conf*=1.0-smoothstep(0.05,0.2,mismatch);
    // Third signal: the match error the flow pass already measured for this
    // block. Endpoint consistency alone accepts motion that warps to the wrong
    // content when both directions agree on a bad match.
    vec2 matchCost=textureLod(costImage,uv,0).xy;
    conf*=1.0-smoothstep(0.035,0.100,max(matchCost.x,matchCost.y));
    if(bounds && !stationaryPatch(at) && conf>1e-4){
      // Luma-adaptive midpoint: a plain 50/50 mix drifts when endpoint
      // brightness changes mid-fade; bias by brightness difference so the
      // interpolated value stays at the true half-time point. The bias is
      // centred on the requested phase so a caller can ask for 1/3 or 2/3.
      float denom=max(channelMax(a.rgb)+channelMax(b.rgb),1e-3);
      float bias=0.15f*(channelMax(b.rgb)-channelMax(a.rgb))/denom;
      // A moving object changes brightness at its own edges without being a
      // fade; applying the fade correction there shifts midpoint luma. Gate it
      // on the endpoints agreeing structurally, which a global fade preserves.
      bias*=1.0f-smoothstep(0.02f,0.15f,mismatch);
      float t=clamp(p.phase+bias,p.phase-0.1f,p.phase+0.1f);

      color=mix(current,vec4(mix(a.rgb,b.rgb,t),mix(a.a,b.a,t)),conf*gate);
    }
  }
  imageStore(result,at,color);
}
