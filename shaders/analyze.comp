#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D prevFrame;
layout(binding=1) uniform sampler2D currFrame;
#define THOR_QUALITY_BINDING 2
#include "quality.glsl"
layout(push_constant) uniform Params { ivec2 inputSize; ivec2 gridSize; float phase; int history; } p;
uint bin(vec3 c){uvec3 q=uvec3(clamp(c*4.0,vec3(0),vec3(3)));return (q.r<<4)|(q.g<<2)|q.b;}
void main(){
 ivec2 at=ivec2(gl_GlobalInvocationID.xy),size=p.gridSize*2;
 if(any(greaterThanEqual(at,size)))return;
 vec2 uv=(vec2(at)+0.5)/vec2(size);
 vec3 a=textureLod(prevFrame,uv,0).rgb,b=textureLod(currFrame,uv,0).rgb,d=abs(a-b);
 float luma=abs(dot(a-b,vec3(0.299,0.587,0.114)));
 atomicAdd(stats.rgbSum,uint(dot(d,vec3(1.0/3.0))*65535.0));
 atomicAdd(stats.lumaSum,uint(luma*65535.0));
 atomicAdd(stats.changed,max(max(d.r,d.g),d.b)>0.10?1u:0u);
 atomicAdd(stats.count,1u);
 atomicAdd(stats.previousHistogram[bin(a)],1u);
 atomicAdd(stats.currentHistogram[bin(b)],1u);
}
